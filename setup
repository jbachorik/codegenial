#!/usr/bin/env bash
set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/tools.conf"

usage() {
  cat <<EOF
Usage: $0 <tool-id> <target-directory>

Install codegenial tools to your project.

Arguments:
  tool-id           Tool identifier from tools.conf (e.g., 'claude')
  target-directory  Project directory where tools will be installed

Examples:
  $0 claude ~/my-project
  $0 cursor .

Available tools:
EOF
  list_tools
  exit 1
}

list_tools() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo -e "${RED}Error: Configuration file not found: $CONFIG_FILE${NC}" >&2
    exit 1
  fi

  local in_tool=false
  local tool_id=""
  local tool_name=""
  local tool_desc=""

  while IFS= read -r line || [ -n "$line" ]; do
    # Skip comments and empty lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue

    # Tool section header
    if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\] ]]; then
      # Print previous tool if exists
      if [ "$in_tool" = true ] && [ -n "$tool_id" ]; then
        printf "  ${BLUE}%-12s${NC} %s - %s\n" "$tool_id" "$tool_name" "$tool_desc"
      fi
      tool_id="${BASH_REMATCH[1]}"
      in_tool=true
      tool_name=""
      tool_desc=""
      continue
    fi

    # Parse key-value pairs
    if [ "$in_tool" = true ] && [[ "$line" =~ ^[[:space:]]*([^=]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      # Trim whitespace
      key="$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      value="$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      case "$key" in
        name) tool_name="$value" ;;
        description) tool_desc="$value" ;;
      esac
    fi
  done < "$CONFIG_FILE"

  # Print last tool
  if [ "$in_tool" = true ] && [ -n "$tool_id" ]; then
    printf "  ${BLUE}%-12s${NC} %s - %s\n" "$tool_id" "$tool_name" "$tool_desc"
  fi
}

parse_tool_config() {
  local tool_id="$1"
  local in_tool=false
  local found=false

  # Initialize global variables (bash 3.x compatible)
  TOOL_NAME=""
  TOOL_DESC=""
  TOOL_SOURCE=""
  TOOL_TARGET=""
  TOOL_INSTRUCTIONS_FILE=""

  while IFS= read -r line || [ -n "$line" ]; do
    # Skip comments and empty lines in the middle
    [[ "$line" =~ ^[[:space:]]*# ]] && continue

    # Tool section header
    if [[ "$line" =~ ^\[([a-zA-Z0-9_-]+)\] ]]; then
      if [ "$in_tool" = true ]; then
        # We were in our tool section, now we've reached another tool
        break
      fi
      if [ "${BASH_REMATCH[1]}" = "$tool_id" ]; then
        in_tool=true
        found=true
      fi
      continue
    fi

    # Parse key-value pairs
    if [ "$in_tool" = true ] && [[ "$line" =~ ^[[:space:]]*([^=]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      # Trim whitespace
      key="$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      value="$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      case "$key" in
        name) TOOL_NAME="$value" ;;
        description) TOOL_DESC="$value" ;;
        source) TOOL_SOURCE="$value" ;;
        target) TOOL_TARGET="$value" ;;
        instructions_file) TOOL_INSTRUCTIONS_FILE="$value" ;;
      esac
    fi
  done < "$CONFIG_FILE"

  if [ "$found" = false ]; then
    echo -e "${RED}Error: Tool '$tool_id' not found in configuration${NC}" >&2
    echo ""
    echo "Available tools:"
    list_tools
    exit 1
  fi

  # Validate required fields
  if [ -z "$TOOL_SOURCE" ] || [ -z "$TOOL_TARGET" ]; then
    echo -e "${RED}Error: Invalid configuration for tool '$tool_id'${NC}" >&2
    echo "Required fields: source, target"
    exit 1
  fi
}

install_tool() {
  local tool_id="$1"
  local target_dir="$2"

  # Parse configuration
  parse_tool_config "$tool_id"

  echo -e "${BLUE}Installing:${NC} $TOOL_NAME"
  echo -e "${BLUE}Description:${NC} $TOOL_DESC"
  echo ""

  # Resolve paths
  local source_path="${SCRIPT_DIR}/${TOOL_SOURCE}"
  local target_path="${target_dir}/${TOOL_TARGET}"

  # Validate source exists
  if [ ! -d "$source_path" ]; then
    echo -e "${RED}Error: Source directory not found: $source_path${NC}" >&2
    exit 1
  fi

  # Validate instructions file exists if specified
  if [ -n "$TOOL_INSTRUCTIONS_FILE" ]; then
    if [ ! -f "$target_dir/$TOOL_INSTRUCTIONS_FILE" ]; then
      echo -e "${RED}Error: Instructions file not found: $target_dir/$TOOL_INSTRUCTIONS_FILE${NC}" >&2
      echo "The tool requires '$TOOL_INSTRUCTIONS_FILE' to exist in the target directory."
      exit 1
    fi
  fi

  # Check if target already exists
  if [ -d "$target_path" ]; then
    echo -e "${YELLOW}Warning: Target directory already exists: $target_path${NC}"
    read -p "Overwrite? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo "Installation cancelled."
      exit 0
    fi
    echo -e "${YELLOW}Removing existing directory...${NC}"
    rm -rf "$target_path"
  fi

  # Create parent directory if needed
  mkdir -p "$(dirname "$target_path")"

  # Copy files (excluding files starting with '_')
  echo -e "${BLUE}Copying files...${NC}"
  echo "  From: $source_path"
  echo "  To:   $target_path"

  # Create target directory
  mkdir -p "$target_path"

  # Copy files, excluding those starting with '_'
  (cd "$source_path" && find . -type f ! -name '_*' -exec sh -c '
    target_file="'"$target_path"'/$1"
    mkdir -p "$(dirname "$target_file")"
    cp "$1" "$target_file"
  ' sh {} \;)

  # Copy directories (structure)
  (cd "$source_path" && find . -type d ! -name '_*' -exec sh -c '
    mkdir -p "'"$target_path"'/$1"
  ' sh {} \;)

  # Make command scripts executable
  if [ -d "${target_path}/commands" ]; then
    find "${target_path}/commands" -type f ! -name "*.md" -exec chmod +x {} \;
  fi

  # Handle _add_instructions.md if it exists
  local add_instructions="${source_path}/_add_instructions.md"
  if [ -f "$add_instructions" ] && [ -n "$TOOL_INSTRUCTIONS_FILE" ]; then
    local instructions_path="$target_dir/$TOOL_INSTRUCTIONS_FILE"

    # Check if already appended (idempotent)
    local marker="<!-- codegenial:${TOOL_SOURCE}:added -->"
    if grep -q "$marker" "$instructions_path" 2>/dev/null; then
      echo -e "${YELLOW}Additional instructions already present, skipping...${NC}"
    else
      echo -e "${BLUE}Appending additional instructions...${NC}"
      {
        echo ""
        echo "# Additional Tool Instructions"
        echo ""
        cat "$add_instructions"
        echo ""
        echo "$marker"
      } >> "$instructions_path"
    fi
  fi

  echo ""
  echo -e "${GREEN}✓ Installation complete!${NC}"
  echo ""
  echo "Files installed to: $target_path"

  # Show next steps based on tool
  case "$tool_id" in
    claude)
      echo ""
      echo "Next steps:"
      echo "  1. Navigate to your project: cd $target_dir"
      echo "  2. Run builds with log analysis: ./.claude/commands/build-and-summarize"
      echo "  3. View available agents: ls .claude/agents/"
      ;;
  esac
}

# Main script
main() {
  if [ $# -eq 0 ]; then
    usage
  fi

  if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
  fi

  if [ "$1" = "list" ]; then
    echo "Available tools:"
    list_tools
    exit 0
  fi

  if [ $# -ne 2 ]; then
    echo -e "${RED}Error: Invalid number of arguments${NC}" >&2
    echo ""
    usage
  fi

  local tool_id="$1"
  local target_dir="$2"

  # Resolve target directory
  target_dir="$(cd "$target_dir" 2>/dev/null && pwd || echo "$target_dir")"

  if [ ! -d "$target_dir" ]; then
    echo -e "${RED}Error: Target directory does not exist: $target_dir${NC}" >&2
    exit 1
  fi

  install_tool "$tool_id" "$target_dir"
}

main "$@"
